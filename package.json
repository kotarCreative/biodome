{
  "name": "@kotarcreative/biodome",
  "version": "0.1.0",
  "description": "Self-contained development environments powered by composable primitives",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "biodome": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "biodome",
    "development-environment",
    "containers",
    "dev-server"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@effect/platform-node": "^4.0.0-beta.98",
    "@effect/platform-node-shared": "^4.0.0-beta.98",
    "commander": "^12.0.0",
    "effect": "^4.0.0-beta.98",
    "yaml": "^2.5.0"
  }
}
