{
  "name": "@kotarcreative/biodome",
  "version": "0.1.0",
  "description": "Self-contained development environments powered by composable primitives",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/apps/index.d.ts",
      "import": "./dist/apps/index.js"
    }
  },
  "bin": {
    "biodome": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "prepack": "npm run build",
    "dev": "npm run build && node dist/cli/index.js",
    "format": "oxfmt --write src docs",
    "format:check": "oxfmt --check src docs",
    "lint": "oxlint --disable-nested-config -c .oxlintrc.json src",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:run",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "biodome",
    "development-environment",
    "containers",
    "dev-server"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1092.0",
    "@aws-sdk/client-ecr": "^3.1092.0",
    "@aws-sdk/client-ecs": "^3.1092.0",
    "@aws-sdk/client-s3": "^3.1091.0",
    "@azure/storage-blob": "^12.33.0",
    "@effect/opentelemetry": "4.0.0-beta.103",
    "@effect/platform-node": "4.0.0-beta.103",
    "@effect/platform-node-shared": "4.0.0-beta.103",
    "@google-cloud/storage": "^7.21.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/sdk-trace-web": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "commander": "^12.0.0",
    "effect": "4.0.0-beta.103",
    "yaml": "^2.5.0"
  },
  "overrides": {
    "fast-uri": "^3.1.5",
    "ip-address": "^10.3.1",
    "undici": "^8.9.0"
  }
}
