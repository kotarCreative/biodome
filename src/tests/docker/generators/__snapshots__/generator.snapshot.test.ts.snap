"# syntax=docker/dockerfile:1
# Auto-generated by biodome
# Multi-stage build: base -> deps -> dev
#
# BuildKit cache mounts are used for apt, npm, pnpm, pip, composer, go mod, and cargo
# so iterative rebuilds skip downloading already-cached packages.
# The dev stage starts from base and copies only the installed artifacts from
# deps, so the final image does not include package manager caches or manifests.

FROM node:20-slim AS base

# Install system packages + service CLI clients.
# Cache mounts prevent re-downloading the apt index every rebuild.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \\
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \\
    apt-get update && apt-get install -y --no-install-recommends \\
    netcat-openbsd \\
    supervisor \\
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# Non-root runtime identities: user workloads never run as root.
# supervisord starts as root only to initialize paths and setuid programs.
RUN if command -v groupadd >/dev/null 2>&1; then \\
    groupadd -f --gid 10001 biodome && \\
    groupadd -f --gid 10002 biodome-mcp && \\
    groupadd -f --gid 10003 biodome-mount && \\
    useradd --uid 10001 --gid biodome --create-home --shell /bin/sh biodome && \\
    useradd --uid 10002 --gid biodome-mcp --groups biodome --create-home --shell /bin/sh biodome-mcp && \\
    useradd --uid 10003 --gid biodome-mount --create-home --shell /bin/sh biodome-mount; \\
elif command -v addgroup >/dev/null 2>&1; then \\
    addgroup -g 10001 biodome && \\
    addgroup -g 10002 biodome-mcp && \\
    addgroup -g 10003 biodome-mount && \\
    adduser -u 10001 -G biodome -D -s /bin/sh biodome && \\
    adduser -u 10002 -G biodome-mcp -D -s /bin/sh biodome-mcp && \\
    adduser -u 10003 -G biodome-mount -D -s /bin/sh biodome-mount && \\
    adduser biodome-mcp biodome; \\
else \\
    echo "No user management tooling available; cannot create runtime identities" >&2; exit 1; \\
fi

# Stage 2: deps
FROM base AS deps
WORKDIR /workspace

# Stage 3: dev
FROM base AS dev
WORKDIR /workspace

# Assign ownership only to image-borne workspace and generated paths.
RUN chown -R biodome:biodome /workspace
RUN chmod -R g+rX /workspace

# Copy the managed-process startup script.
COPY .biodome-build/startup.sh /workspace/.biodome-build/startup.sh

# Run lifecycle hooks, then start managed processes when declared.
CMD ["sh", "/workspace/.biodome-build/startup.sh"]
"
`;

exports[`Docker generator snapshots > matches for multi-daemon with workingDir + tcp healthcheck 2`] = `
"; Auto-generated by biodome
; Managed processes declared in biodome/features/*.js
[supervisord]
nodaemon=true
logfile=/workspace/.biodome-build/logs/supervisord.log
pidfile=/workspace/.biodome-build/logs/supervisord.pid
user=root

[unix_http_server]
file=/workspace/.biodome-build/logs/supervisor.sock
chmod=0770
chown=root:biodome

[supervisorctl]
serverurl=unix:///workspace/.biodome-build/logs/supervisor.sock

[rpcinterface:supervisor]
supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface

[program:backend]
command=node api.js
user=biodome
autostart=false
autorestart=true
startretries=10
stdout_logfile=/workspace/.biodome-build/logs/backend.log
stderr_logfile=/workspace/.biodome-build/logs/backend.log
environment=BIODOME_LOG_DIR="/workspace/.biodome-build/logs"

[program:backend-healthcheck]
command=sh /workspace/.biodome-build/healthchecks/backend-monitor.sh
user=root
autostart=false
autorestart=true
startsecs=5
stdout_logfile=/workspace/.biodome-build/logs/backend-healthcheck.log
stderr_logfile=/workspace/.biodome-build/logs/backend-healthcheck.log

[program:frontend]
command=npm run dev
directory="/workspace/frontend"
user=biodome
autostart=false
autorestart=true
startretries=10
stdout_logfile=/workspace/.biodome-build/logs/frontend.log
stderr_logfile=/workspace/.biodome-build/logs/frontend.log
environment=BIODOME_LOG_DIR="/workspace/.biodome-build/logs"

"
`;

