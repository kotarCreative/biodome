exports[`Docker generator snapshots > matches for multi-daemon with workingDir + tcp healthcheck 1`] = `
"# syntax=docker/dockerfile:1
# Auto-generated by biodome
# Multi-stage build: base -> deps -> dev
#
# BuildKit cache mounts are used for apt, npm, pnpm, pip, composer, go mod, and cargo
# so iterative rebuilds skip downloading already-cached packages.
# The dev stage starts from base and copies only the installed artifacts from
# deps, so the final image does not include package manager caches or manifests.

FROM node:20-slim AS base

# Install system packages + service CLI clients.
# Cache mounts prevent re-downloading the apt index every rebuild.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \\
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \\
    apt-get update && apt-get install -y --no-install-recommends \\
    netcat-openbsd \\
    supervisor \\
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# Stage 2: deps
FROM base AS deps
WORKDIR /workspace

# Stage 3: dev
FROM base AS dev
WORKDIR /workspace

# Copy the managed-process startup script.
COPY .biodome-build/startup.sh /workspace/.biodome-build/startup.sh

# Run lifecycle hooks, then start managed processes when declared.
CMD ["sh", "/workspace/.biodome-build/startup.sh"]
"
`;

exports[`Docker generator snapshots > matches for multi-daemon with workingDir + tcp healthcheck 2`] = `
"; Auto-generated by biodome
; Managed processes declared in biodome/features/*.js
[supervisord]
nodaemon=true
logfile=/workspace/.biodome-build/logs/supervisord.log
pidfile=/workspace/.biodome-build/logs/supervisord.pid
user=root

[unix_http_server]
file=/workspace/.biodome-build/logs/supervisor.sock

[supervisorctl]
serverurl=unix:///workspace/.biodome-build/logs/supervisor.sock

[rpcinterface:supervisor]
supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface

[program:backend]
command=node api.js
autostart=false
autorestart=true
startretries=10
stdout_logfile=/workspace/.biodome-build/logs/backend.log
stderr_logfile=/workspace/.biodome-build/logs/backend.log
environment=BIODOME_LOG_DIR="/workspace/.biodome-build/logs"

[program:backend-healthcheck]
command=sh /workspace/.biodome-build/healthchecks/backend-monitor.sh
autostart=false
autorestart=true
startsecs=5
stdout_logfile=/workspace/.biodome-build/logs/backend-healthcheck.log
stderr_logfile=/workspace/.biodome-build/logs/backend-healthcheck.log

[program:frontend]
command=npm run dev
directory=/workspace/frontend
autostart=false
autorestart=true
startretries=10
stdout_logfile=/workspace/.biodome-build/logs/frontend.log
stderr_logfile=/workspace/.biodome-build/logs/frontend.log
environment=BIODOME_LOG_DIR="/workspace/.biodome-build/logs"

"
`;

exports[`Docker generator snapshots > matches for multi-daemon with workingDir + tcp healthcheck 3`] = `
"# Auto-generated by biodome
# Source: .biodome/ directory
# Do not edit this file directly; it will be regenerated.
services:
  dev:
    build:
      context: ..
      dockerfile: .biodome-build/Dockerfile
    image: \${BIODOME_DEV_IMAGE:-multi-app-dev:latest}
    container_name: multi-app-dev
    working_dir: /workspace
    volumes:
      - ..:/workspace
    networks:
      - biodome
    ports:
      - 8000:8000
      - 3000:3000
    healthcheck:
      test:
        - CMD-SHELL
        - sh /workspace/.biodome-build/healthchecks/all.sh
      interval: 5s
      timeout: 3s
      retries: 3
      start_period: 10s
volumes: {}
networks:
  biodome:
    driver: bridge

"
`;

exports[`Docker generator snapshots > matches for multi-language runtime installs 1`] = `
"# syntax=docker/dockerfile:1
# Auto-generated by biodome
# Multi-stage build: base -> deps -> dev
#
# BuildKit cache mounts are used for apt, npm, pnpm, pip, composer, go mod, and cargo
# so iterative rebuilds skip downloading already-cached packages.
# The dev stage starts from base and copies only the installed artifacts from
# deps, so the final image does not include package manager caches or manifests.

FROM debian:12-slim AS base

RUN apt-get update && curl -fsSL https://pyenv.run | bash
RUN apt-get update && curl -fsSL https://deb.nodesource.com/setup_20.x | bash

RUN corepack enable

# Stage 2: deps
FROM base AS deps
WORKDIR /workspace

COPY requirements.txt package.json package-lock.json /workspace/

RUN python -m venv /workspace/.venv && /workspace/.venv/bin/pip install -r requirements.txt

RUN npm ci

# Stage 3: dev
FROM base AS dev
WORKDIR /workspace

COPY --from=deps /workspace/.venv /workspace/.venv
ENV PATH=/workspace/.venv/bin:$PATH

COPY --from=deps /workspace/node_modules /workspace/node_modules

# Source code is mounted at runtime via 'docker run -v .:/workspace'
CMD ["bash"]
"
`;

exports[`Docker generator snapshots > matches for multi-language runtime installs 2`] = `""`;

