exports[`Docker generator snapshots > matches for node + postgres + daemon 3`] = `
"# Auto-generated by biodome
# Source: .biodome/ directory
# Do not edit this file directly; it will be regenerated.
services:
  dev:
    build:
      context: ..
      dockerfile: .biodome-build/Dockerfile
    image: \${BIODOME_DEV_IMAGE:-my-app-dev:latest}
    container_name: my-app-dev
    working_dir: /workspace
    volumes:
      - ..:/workspace
      - node_modules:/workspace/node_modules
    networks:
      - biodome
    ports:
      - 3000:3000
    healthcheck:
      test:
        - CMD-SHELL
        - sh /workspace/.biodome-build/healthchecks/all.sh
      interval: 5s
      timeout: 3s
      retries: 10
      start_period: 10s
    depends_on:
      postgres:
        condition: service_healthy
  postgres:
    image: postgres:16-alpine
    container_name: my-app-postgres
    networks:
      - biodome
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: dev
      POSTGRES_DB: myapp
    ports:
      - 5432:5432
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U app -d myapp
      interval: 5s
      timeout: 3s
      retries: 10
volumes:
  postgres_data: {}
  node_modules: {}
networks:
  biodome:
    driver: bridge

"
`;

exports[`Docker generator snapshots > matches for php + composer + vendor volume 1`] = `
"# syntax=docker/dockerfile:1
# Auto-generated by biodome
# Multi-stage build: base -> deps -> dev
#
# BuildKit cache mounts are used for apt, npm, pnpm, pip, composer, go mod, and cargo
# so iterative rebuilds skip downloading already-cached packages.
# The dev stage starts from base and copies only the installed artifacts from
# deps, so the final image does not include package manager caches or manifests.

FROM php:8.3-cli AS base

# Install system packages + service CLI clients.
# Cache mounts prevent re-downloading the apt index every rebuild.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \\
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \\
    apt-get update && apt-get install -y --no-install-recommends \\
    curl \\
    supervisor \\
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# Stage 2: deps
FROM base AS deps
WORKDIR /workspace

COPY composer.json composer.lock /workspace/

RUN --mount=type=cache,target=/root/.composer/cache composer install --no-interaction --no-progress --optimize-autoloader && rm -rf /root/.composer/cache/*

# Stage 3: dev
FROM base AS dev
WORKDIR /workspace

COPY --from=deps /workspace/vendor /workspace/vendor

# Copy the managed-process startup script.
COPY .biodome-build/startup.sh /workspace/.biodome-build/startup.sh

# Run lifecycle hooks, then start managed processes when declared.
CMD ["sh", "/workspace/.biodome-build/startup.sh"]
"
`;

