"# Auto-generated by biodome
# Source: .biodome/ directory
# Do not edit this file directly; it will be regenerated.
services:
  dev:
    build:
      context: ..
      dockerfile: .biodome-build/Dockerfile
    image: \${BIODOME_DEV_IMAGE:-py-app-dev:latest}
    container_name: py-app-dev
    working_dir: /workspace
    volumes:
      - ..:/workspace
      - venv:/workspace/.venv
    networks:
      - biodome
    command:
      - sleep
      - infinity
    depends_on:
      redis:
        condition: service_healthy
  redis:
    image: redis:7-alpine
    container_name: py-app-redis
    networks:
      - biodome
    ports:
      - 6379:6379
    volumes:
      - redis_data:/data
    healthcheck:
      test:
        - CMD-SHELL
        - redis-cli ping | grep -q PONG
      interval: 5s
      timeout: 3s
      retries: 10
volumes:
  redis_data: {}
  venv: {}
networks:
  biodome:
    driver: bridge

"
`;
