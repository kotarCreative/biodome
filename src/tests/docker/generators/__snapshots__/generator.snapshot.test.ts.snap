COPY --from=deps /workspace/.venv /workspace/.venv
ENV PATH=/workspace/.venv/bin:$PATH

# Assign ownership only to image-borne workspace and generated paths.
RUN chown -R biodome:biodome /workspace
RUN chmod -R g+rX /workspace

USER biodome

# Source code is mounted at runtime via 'docker run -v .:/workspace'
CMD ["bash"]
"
`;

exports[`Docker generator snapshots > matches for python + venv + redis 2`] = `""`;

exports[`Docker generator snapshots > matches for python + venv + redis 3`] = `
"# Auto-generated by biodome
# Source: .biodome/ directory
# Do not edit this file directly; it will be regenerated.
services:
  dev:
    build:
      context: ..
      dockerfile: .biodome-build/Dockerfile
    image: \${BIODOME_DEV_IMAGE:-py-app-dev:latest}
    container_name: py-app-dev
    working_dir: /workspace
    volumes:
      - ..:/workspace
      - venv:/workspace/.venv
    networks:
      - biodome
    environment:
      BIODOME_RUNTIME_UID: \${BIODOME_RUNTIME_UID:-10001}
      BIODOME_RUNTIME_GID: \${BIODOME_RUNTIME_GID:-10001}
    command:
      - sleep
      - infinity
volumes:
  venv: {}
networks:
  biodome:
    driver: bridge

"
`;
