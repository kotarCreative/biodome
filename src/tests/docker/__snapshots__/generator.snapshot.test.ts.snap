exports[`Docker generator snapshots > matches for node + postgres + daemon 3`] = `
"# Auto-generated by sandbox-manager
# Source: sandbox/ directory
# Do not edit this file directly; it will be regenerated.
services:
  dev:
    build:
      context: ..
      dockerfile: .sandbox/Dockerfile
    image: my-app-dev:latest
    container_name: my-app-dev
    working_dir: /workspace
    volumes:
      - ..:/workspace
      - node_modules:/workspace/node_modules
    networks:
      - sandbox
    ports:
      - 3000:3000
    healthcheck:
      test:
        - CMD-SHELL
        - curl -fsS http://localhost:3000/health
      interval: 5s
      timeout: 3s
      retries: 10
    depends_on:
      postgres:
        condition: service_healthy
  postgres:
    image: postgres:16-alpine
    container_name: my-app-postgres
    networks:
      - sandbox
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: dev
      POSTGRES_DB: myapp
    ports:
      - 5432:5432
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U app -d myapp
      interval: 5s
      timeout: 3s
      retries: 10
volumes:
  postgres_data: {}
  node_modules: {}
networks:
  sandbox:
    driver: bridge

"
`;

exports[`Docker generator snapshots > matches for python + venv + redis 1`] = `
"# syntax=docker/dockerfile:1
# Auto-generated by sandbox-manager
# Multi-stage build: base -> deps -> dev
#
# BuildKit cache mounts are used for apt, npm, pnpm, pip, go mod, and cargo
# so iterative rebuilds skip downloading already-cached packages.
# The dev stage starts from base and copies only the installed artifacts from
# deps, so the final image does not include package manager caches or manifests.

FROM python:3.12-slim AS base

# Install system packages + service CLI clients.
# Cache mounts prevent re-downloading the apt index every rebuild.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \\
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \\
    apt-get update && apt-get install -y --no-install-recommends \\
    supervisor \\
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# Stage 2: deps
FROM base AS deps
WORKDIR /workspace

COPY requirements.txt /workspace/

RUN python -m venv /workspace/.venv && /workspace/.venv/bin/pip install -r requirements.txt

# Stage 3: dev
FROM base AS dev
WORKDIR /workspace

COPY --from=deps /workspace/.venv /workspace/.venv
ENV PATH=/workspace/.venv/bin:$PATH

# Source code is mounted at runtime via 'docker run -v .:/workspace'
CMD ["bash"]
"
`;

exports[`Docker generator snapshots > matches for python + venv + redis 2`] = `""`;

exports[`Docker generator snapshots > matches for python + venv + redis 3`] = `
"# Auto-generated by sandbox-manager
# Source: sandbox/ directory
# Do not edit this file directly; it will be regenerated.
services:
  dev:
    build:
      context: ..
      dockerfile: .sandbox/Dockerfile
    image: py-app-dev:latest
    container_name: py-app-dev
    working_dir: /workspace
    volumes:
      - ..:/workspace
      - venv:/workspace/.venv
    networks:
      - sandbox
    command:
      - sleep
      - infinity
    depends_on:
      redis:
        condition: service_healthy
  redis:
    image: redis:7-alpine
    container_name: py-app-redis
    networks:
      - sandbox
    ports:
      - 6379:6379
    volumes:
      - redis_data:/data
    healthcheck:
      test:
        - CMD-SHELL
        - redis-cli ping | grep -q PONG
      interval: 5s
      timeout: 3s
      retries: 10
volumes:
  redis_data: {}
  venv: {}
networks:
  sandbox:
    driver: bridge

"
`;
