exports[`Docker generator snapshots > matches for multi-daemon with workingDir + tcp healthcheck 1`] = `
"# syntax=docker/dockerfile:1
# Auto-generated by sandbox-manager
# Multi-stage build: base -> deps -> dev
#
# BuildKit cache mounts are used for apt, npm, pnpm, pip, go mod, and cargo
# so iterative rebuilds skip downloading already-cached packages.
# The dev stage starts from base and copies only the installed artifacts from
# deps, so the final image does not include package manager caches or manifests.

FROM node:20-slim AS base

# Install system packages + service CLI clients.
# Cache mounts prevent re-downloading the apt index every rebuild.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \\
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \\
    apt-get update && apt-get install -y --no-install-recommends \\
    netcat-openbsd \\
    supervisor \\
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# Stage 2: deps
FROM base AS deps
WORKDIR /workspace

# Stage 3: dev
FROM base AS dev
WORKDIR /workspace

# Copy supervisord configuration for managed processes.
COPY .sandbox/supervisord.conf /workspace/.sandbox/supervisord.conf

# Start managed processes via supervisord.
CMD ["supervisord", "-c", "/workspace/.sandbox/supervisord.conf"]
"
`;

exports[`Docker generator snapshots > matches for multi-daemon with workingDir + tcp healthcheck 2`] = `
"; Auto-generated by sandbox-manager
; Managed processes declared in sandbox/features/*.js
[supervisord]
nodaemon=true
logfile=/tmp/supervisord.log
pidfile=/tmp/supervisord.pid
user=root

[program:backend]
command=node api.js
autostart=true
autorestart=true
startretries=10
stdout_logfile=/tmp/backend.log
stderr_logfile=/tmp/backend.log

[program:frontend]
command=npm run dev
directory=/workspace/frontend
autostart=true
autorestart=true
startretries=10
stdout_logfile=/tmp/frontend.log
stderr_logfile=/tmp/frontend.log

"
`;

